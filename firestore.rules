rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'xuwonixweb@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isBootstrappedAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/institution/config)
          && get(/databases/$(database)/documents/institution/config).data.superAdminUid == request.auth.uid
        );
    }

    function isAdmin() {
      return isSuperAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidRefId(val) {
      return val is string && val.size() >= 1 && val.size() <= 128 && val.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isCreateTimestamps(data) {
      return data.createdAt == request.time && data.updatedAt == request.time;
    }

    function isUpdateTimestamps(data) {
      return data.createdAt == existing().createdAt && data.updatedAt == request.time;
    }

    function isValidBoardViewerList(arr) {
      return arr is list
        && arr.size() <= 25
        && (arr.size() == 0 || isValidRefId(arr[0]));
    }

    function isValidTeacherViewerList(arr) {
      return arr is list
        && arr.size() <= 50
        && (arr.size() == 0 || isValidRefId(arr[0]));
    }

    function isBoardViewer(data) {
      return 'boardViewerUids' in data
        && data.boardViewerUids is list
        && request.auth.uid in data.boardViewerUids;
    }

    function isTeacherRuleViewer(data) {
      return 'teacherViewerUids' in data
        && data.teacherViewerUids is list
        && request.auth.uid in data.teacherViewerUids;
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS (Synced verbatim with firebase-blueprint.json)
    // =========================================================================
    function isValidInstitutionConfig(data) {
      return data.keys().hasAll(['setupComplete', 'superAdminUid', 'schoolName', 'schoolCode', 'schoolAddress', 'schoolOwner', 'ownerUsername', 'emailOtpVerified', 'phoneOtpVerified', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['setupComplete', 'superAdminUid', 'schoolName', 'schoolCode', 'schoolAddress', 'schoolOwner', 'ownerUsername', 'emailOtpVerified', 'phoneOtpVerified', 'createdAt', 'updatedAt'])
        && data.setupComplete is bool
        && isValidRefId(data.superAdminUid)
        && isNonEmptyString(data.schoolName, 120)
        && data.schoolCode is string && data.schoolCode.size() >= 2 && data.schoolCode.size() <= 24 && data.schoolCode.matches('^[a-zA-Z0-9_\\-]+$')
        && data.schoolAddress is string && data.schoolAddress.size() >= 3 && data.schoolAddress.size() <= 240
        && isNonEmptyString(data.schoolOwner, 100)
        && data.ownerUsername is string && data.ownerUsername.size() >= 3 && data.ownerUsername.size() <= 48 && data.ownerUsername.matches('^[a-zA-Z0-9._\\-]+$')
        && data.emailOtpVerified is bool
        && data.phoneOtpVerified is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'ownerId', 'displayName', 'username', 'role', 'schoolName', 'department', 'avatarUrl', 'accountStatus', 'seeded', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'ownerId', 'displayName', 'username', 'role', 'schoolName', 'department', 'avatarUrl', 'accountStatus', 'seeded', 'createdAt', 'updatedAt'])
        && isValidRefId(data.uid)
        && isValidRefId(data.ownerId)
        && isNonEmptyString(data.displayName, 100)
        && isOptionalString(data.username, 48)
        && data.role in ['super_admin', 'admin', 'board', 'teacher', 'staff', 'student']
        && isNonEmptyString(data.schoolName, 120)
        && isNonEmptyString(data.department, 80)
        && isOptionalString(data.avatarUrl, 300)
        && data.accountStatus in ['active', 'suspended']
        && data.seeded is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'createdAt', 'updatedAt'])
        && isValidRefId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && isOptionalString(data.phone, 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRegistry(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'grantedBy', 'createdAt'])
        && isValidRefId(data.uid)
        && isNonEmptyString(data.grantedBy, 128)
        && data.createdAt is timestamp;
    }

    function isValidRoleInvite(data) {
      return data.keys().hasAll(['targetUid', 'fullName', 'role', 'department', 'status', 'createdByUid', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['targetUid', 'fullName', 'role', 'department', 'status', 'createdByUid', 'ownerId', 'createdAt', 'updatedAt'])
        && isValidRefId(data.targetUid)
        && isNonEmptyString(data.fullName, 100)
        && data.role in ['admin', 'board', 'teacher', 'staff', 'student']
        && isNonEmptyString(data.department, 80)
        && data.status in ['active', 'revoked']
        && isValidRefId(data.createdByUid)
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidContactInquiry(data) {
      return data.keys().hasAll(['fullName', 'institutionName', 'workEmail', 'phone', 'topic', 'message', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fullName', 'institutionName', 'workEmail', 'phone', 'topic', 'message', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.fullName, 100)
        && isNonEmptyString(data.institutionName, 120)
        && data.workEmail is string && data.workEmail.size() >= 3 && data.workEmail.size() <= 160
        && isOptionalString(data.phone, 40)
        && data.topic in ['Demo Request', 'Admissions Suite', 'District Rollout', 'Technical Support', 'Partnership']
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 1500
        && data.status in ['new', 'reviewed', 'archived']
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCareerApplication(data) {
      return data.keys().hasAll(['applicantName', 'email', 'roleTitle', 'department', 'portfolioUrl', 'coverNote', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['applicantName', 'email', 'roleTitle', 'department', 'portfolioUrl', 'coverNote', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.applicantName, 100)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && isNonEmptyString(data.roleTitle, 120)
        && isNonEmptyString(data.department, 80)
        && isOptionalString(data.portfolioUrl, 300)
        && data.coverNote is string && data.coverNote.size() >= 10 && data.coverNote.size() <= 1500
        && data.status in ['submitted', 'reviewing', 'closed']
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchoolClass(data) {
      return data.keys().hasAll(['name', 'code', 'gradeLevel', 'room', 'scheduleSlot', 'teacherName', 'teacherStaffId', 'assignedTeacherId', 'capacity', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'code', 'gradeLevel', 'room', 'scheduleSlot', 'teacherName', 'teacherStaffId', 'assignedTeacherId', 'capacity', 'boardViewerUids', 'ownerId', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.name, 100)
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 24 && data.code.matches('^[a-zA-Z0-9_\\-]+$')
        && isNonEmptyString(data.gradeLevel, 30)
        && isNonEmptyString(data.room, 40)
        && isNonEmptyString(data.scheduleSlot, 60)
        && isNonEmptyString(data.teacherName, 100)
        && isValidRefId(data.teacherStaffId)
        && isValidRefId(data.assignedTeacherId)
        && data.capacity is number && data.capacity >= 1 && data.capacity <= 120
        && (!('boardViewerUids' in data) || isValidBoardViewerList(data.boardViewerUids))
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['firstName', 'lastName', 'studentCode', 'gradeLevel', 'classId', 'className', 'guardianName', 'preferredChannel', 'enrollmentStatus', 'attendanceRate', 'linkedUserUid', 'ownerId', 'assignedTeacherId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['firstName', 'lastName', 'studentCode', 'gradeLevel', 'classId', 'className', 'guardianName', 'preferredChannel', 'enrollmentStatus', 'attendanceRate', 'linkedUserUid', 'boardViewerUids', 'ownerId', 'assignedTeacherId', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.firstName, 60)
        && isNonEmptyString(data.lastName, 60)
        && data.studentCode is string && data.studentCode.size() >= 2 && data.studentCode.size() <= 32 && data.studentCode.matches('^[a-zA-Z0-9_\\-]+$')
        && isNonEmptyString(data.gradeLevel, 30)
        && isValidRefId(data.classId)
        && isNonEmptyString(data.className, 100)
        && isNonEmptyString(data.guardianName, 100)
        && data.preferredChannel in ['SMS', 'Email', 'App Push']
        && data.enrollmentStatus in ['active', 'probation', 'transferred', 'graduated']
        && data.attendanceRate is number && data.attendanceRate >= 0 && data.attendanceRate <= 100
        && isOptionalString(data.linkedUserUid, 128)
        && (!('boardViewerUids' in data) || isValidBoardViewerList(data.boardViewerUids))
        && isValidRefId(data.ownerId)
        && isValidRefId(data.assignedTeacherId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentGuardianPrivate(data) {
      return data.keys().hasAll(['guardianEmail', 'guardianPhone', 'emergencyNotes', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['guardianEmail', 'guardianPhone', 'emergencyNotes', 'ownerId', 'createdAt', 'updatedAt'])
        && data.guardianEmail is string && data.guardianEmail.size() >= 3 && data.guardianEmail.size() <= 160
        && data.guardianPhone is string && data.guardianPhone.size() >= 5 && data.guardianPhone.size() <= 40
        && isOptionalString(data.emergencyNotes, 300)
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'classId', 'className', 'date', 'period', 'status', 'note', 'notifiedParent', 'recordedByUid', 'ownerId', 'assignedTeacherId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'studentName', 'classId', 'className', 'date', 'period', 'status', 'note', 'notifiedParent', 'recordedByUid', 'ownerId', 'assignedTeacherId', 'createdAt', 'updatedAt'])
        && isValidRefId(data.studentId)
        && isNonEmptyString(data.studentName, 120)
        && isValidRefId(data.classId)
        && isNonEmptyString(data.className, 100)
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isNonEmptyString(data.period, 32)
        && data.status in ['present', 'tardy', 'absent', 'excused']
        && isOptionalString(data.note, 300)
        && data.notifiedParent is bool
        && isValidRefId(data.recordedByUid)
        && isValidRefId(data.ownerId)
        && isValidRefId(data.assignedTeacherId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidParentNotification(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'guardianName', 'classId', 'channel', 'triggerType', 'subject', 'message', 'deliveryStatus', 'parentReply', 'ownerId', 'assignedTeacherId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'studentName', 'guardianName', 'classId', 'channel', 'triggerType', 'subject', 'message', 'deliveryStatus', 'parentReply', 'ownerId', 'assignedTeacherId', 'createdAt', 'updatedAt'])
        && isValidRefId(data.studentId)
        && isNonEmptyString(data.studentName, 120)
        && isNonEmptyString(data.guardianName, 100)
        && isValidRefId(data.classId)
        && data.channel in ['SMS', 'Email', 'App Push']
        && data.triggerType in ['auto_absence', 'auto_tardy', 'admission_update', 'teacher_direct', 'attendance_summary']
        && isNonEmptyString(data.subject, 140)
        && isNonEmptyString(data.message, 1000)
        && data.deliveryStatus in ['queued', 'sent', 'delivered', 'acknowledged']
        && isOptionalString(data.parentReply, 500)
        && isValidRefId(data.ownerId)
        && isValidRefId(data.assignedTeacherId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotificationRule(data) {
      return data.keys().hasAll(['name', 'triggerEvent', 'channel', 'delayMinutes', 'templateText', 'enabled', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'triggerEvent', 'channel', 'delayMinutes', 'templateText', 'enabled', 'teacherViewerUids', 'ownerId', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.name, 120)
        && data.triggerEvent in ['absent', 'tardy', 'consecutive_absences', 'admission_stage_change']
        && data.channel in ['SMS', 'Email', 'App Push']
        && data.delayMinutes is number && data.delayMinutes >= 0 && data.delayMinutes <= 1440
        && isNonEmptyString(data.templateText, 600)
        && data.enabled is bool
        && (!('teacherViewerUids' in data) || isValidTeacherViewerList(data.teacherViewerUids))
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmissionApplication(data) {
      return data.keys().hasAll(['applicantName', 'gradeApplying', 'admissionYear', 'guardianName', 'previousSchool', 'stage', 'documentsVerified', 'tuitionDepositPaid', 'interviewDate', 'notes', 'targetClassId', 'enrolledStudentId', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['applicantName', 'gradeApplying', 'admissionYear', 'guardianName', 'previousSchool', 'stage', 'documentsVerified', 'tuitionDepositPaid', 'interviewDate', 'notes', 'targetClassId', 'enrolledStudentId', 'ownerId', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.applicantName, 120)
        && isNonEmptyString(data.gradeApplying, 30)
        && data.admissionYear is number && data.admissionYear >= 2020 && data.admissionYear <= 2035
        && isNonEmptyString(data.guardianName, 100)
        && isNonEmptyString(data.previousSchool, 120)
        && data.stage in ['inquiry', 'tour_scheduled', 'documents_review', 'accepted', 'enrolled', 'declined']
        && data.documentsVerified is bool
        && data.tuitionDepositPaid is bool
        && isOptionalString(data.interviewDate, 32)
        && isOptionalString(data.notes, 500)
        && isValidRefId(data.targetClassId)
        && isOptionalString(data.enrolledStudentId, 128)
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmissionPrivateContact(data) {
      return data.keys().hasAll(['guardianEmail', 'guardianPhone', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['guardianEmail', 'guardianPhone', 'ownerId', 'createdAt', 'updatedAt'])
        && data.guardianEmail is string && data.guardianEmail.size() >= 3 && data.guardianEmail.size() <= 160
        && data.guardianPhone is string && data.guardianPhone.size() >= 5 && data.guardianPhone.size() <= 40
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffMember(data) {
      return data.keys().hasAll(['fullName', 'roleTitle', 'department', 'staffCategory', 'employmentType', 'status', 'avatarUrl', 'weeklyHoursTarget', 'assignedHours', 'attendanceSubmissionRate', 'parentResponseMinutes', 'observationScore', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fullName', 'roleTitle', 'department', 'staffCategory', 'employmentType', 'status', 'avatarUrl', 'weeklyHoursTarget', 'assignedHours', 'attendanceSubmissionRate', 'parentResponseMinutes', 'observationScore', 'linkedUserUid', 'boardViewerUids', 'ownerId', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.fullName, 100)
        && isNonEmptyString(data.roleTitle, 80)
        && isNonEmptyString(data.department, 80)
        && data.staffCategory in ['stakeholder', 'administration', 'teacher', 'staff']
        && data.employmentType in ['Full-Time', 'Part-Time', 'Substitute']
        && data.status in ['active', 'on_leave', 'inactive']
        && isOptionalString(data.avatarUrl, 300)
        && data.weeklyHoursTarget is number && data.weeklyHoursTarget >= 0 && data.weeklyHoursTarget <= 60
        && data.assignedHours is number && data.assignedHours >= 0 && data.assignedHours <= 60
        && data.attendanceSubmissionRate is number && data.attendanceSubmissionRate >= 0 && data.attendanceSubmissionRate <= 100
        && data.parentResponseMinutes is number && data.parentResponseMinutes >= 0 && data.parentResponseMinutes <= 10080
        && data.observationScore is number && data.observationScore >= 0 && data.observationScore <= 100
        && (!('linkedUserUid' in data) || isOptionalString(data.linkedUserUid, 128))
        && (!('boardViewerUids' in data) || isValidBoardViewerList(data.boardViewerUids))
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDepartment(data) {
      return data.keys().hasAll(['name', 'code', 'category', 'headName', 'description', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'code', 'category', 'headName', 'description', 'status', 'boardViewerUids', 'ownerId', 'createdAt', 'updatedAt'])
        && isNonEmptyString(data.name, 100)
        && data.code is string && data.code.size() >= 2 && data.code.size() <= 24 && data.code.matches('^[a-zA-Z0-9_\\-]+$')
        && data.category in ['Academic', 'Administrative', 'Operations', 'Governance']
        && isNonEmptyString(data.headName, 100)
        && isOptionalString(data.description, 300)
        && data.status in ['active', 'inactive']
        && (!('boardViewerUids' in data) || isValidBoardViewerList(data.boardViewerUids))
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFinancialRecord(data) {
      return data.keys().hasAll(['fiscalYear', 'month', 'monthLabel', 'entryType', 'category', 'department', 'amount', 'budgetedAmount', 'status', 'notes', 'boardViewerUids', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['fiscalYear', 'month', 'monthLabel', 'entryType', 'category', 'department', 'amount', 'budgetedAmount', 'status', 'notes', 'boardViewerUids', 'ownerId', 'createdAt', 'updatedAt'])
        && data.fiscalYear is string && data.fiscalYear.size() >= 4 && data.fiscalYear.size() <= 16
        && data.month is string && data.month.size() == 7 && data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && data.monthLabel is string && data.monthLabel.size() >= 3 && data.monthLabel.size() <= 20
        && data.entryType in ['revenue', 'expense']
        && data.category in ['Tuition Fees', 'Admission Fees', 'Grants & Endowment', 'Transport & Lab Fees', 'Faculty Payroll', 'Campus Operations', 'Academic Resources', 'Scholarships & Aid']
        && isNonEmptyString(data.department, 80)
        && data.amount is number && data.amount >= 0 && data.amount <= 100000000
        && data.budgetedAmount is number && data.budgetedAmount >= 0 && data.budgetedAmount <= 100000000
        && data.status in ['collected', 'pending', 'disbursed', 'scheduled']
        && isOptionalString(data.notes, 300)
        && isValidBoardViewerList(data.boardViewerUids)
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidScheduleBlock(data) {
      return data.keys().hasAll(['staffId', 'staffName', 'classId', 'className', 'dayOfWeek', 'periodNumber', 'startTime', 'endTime', 'room', 'subject', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['staffId', 'staffName', 'classId', 'className', 'dayOfWeek', 'periodNumber', 'startTime', 'endTime', 'room', 'subject', 'status', 'assignedTeacherId', 'ownerId', 'createdAt', 'updatedAt'])
        && isValidRefId(data.staffId)
        && isNonEmptyString(data.staffName, 100)
        && isValidRefId(data.classId)
        && isNonEmptyString(data.className, 100)
        && data.dayOfWeek in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri']
        && data.periodNumber is number && data.periodNumber >= 1 && data.periodNumber <= 10
        && data.startTime is string && data.startTime.size() >= 4 && data.startTime.size() <= 16
        && data.endTime is string && data.endTime.size() >= 4 && data.endTime.size() <= 16
        && isNonEmptyString(data.room, 40)
        && isNonEmptyString(data.subject, 80)
        && data.status in ['scheduled', 'conflict', 'substitute_needed']
        && (!('assignedTeacherId' in data) || isOptionalString(data.assignedTeacherId, 128))
        && isValidRefId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // COLLECTIONS
    // =========================================================================

    // 0. Institution First-Time Setup Config (Public non-PII get, one-time atomic create)
    match /institution/{configId} {
      allow get: if isValidId(configId) && configId == 'config';
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(configId)
        && configId == 'config'
        && !exists(/databases/$(database)/documents/institution/config)
        && isValidInstitutionConfig(incoming())
        && isCreateTimestamps(incoming())
        && incoming().setupComplete == true
        && incoming().emailOtpVerified == true
        && incoming().phoneOtpVerified == true
        && incoming().superAdminUid == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(configId)
        && configId == 'config'
        && isValidInstitutionConfig(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().superAdminUid == existing().superAdminUid
        && incoming().setupComplete == true
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['schoolName', 'schoolCode', 'schoolAddress', 'schoolOwner', 'updatedAt']);
      allow delete: if false;
    }

    // 1. Invite-Only Users & Isolated Private PII
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && isCreateTimestamps(incoming())
        && incoming().uid == userId
        && (
          // One-time Super Admin first-run setup (atomically coupled with /institution/config)
          (
            request.auth.uid == userId
            && incoming().ownerId == userId
            && incoming().role == 'super_admin'
            && !exists(/databases/$(database)/documents/institution/config)
            && existsAfter(/databases/$(database)/documents/institution/config)
            && getAfter(/databases/$(database)/documents/institution/config).data.superAdminUid == request.auth.uid
          ) ||
          // Super Admin / Admin provisioning invite-only role accounts
          (
            isAdmin()
            && incoming().ownerId == request.auth.uid
            && incoming().role in ['admin', 'board', 'teacher', 'staff', 'student']
          )
        );
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().uid == existing().uid
        && incoming().ownerId == existing().ownerId
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'schoolName', 'department', 'avatarUrl', 'accountStatus', 'seeded', 'updatedAt'])) ||
          (request.auth.uid == userId && incoming().role == existing().role && incoming().accountStatus == existing().accountStatus && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'avatarUrl', 'seeded', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();

      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId)
          && (request.auth.uid == userId || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;
        allow create: if isSignedIn() && isValidId(userId) && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && isCreateTimestamps(incoming())
          && incoming().uid == userId
          && (request.auth.uid == userId || isAdmin())
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isSignedIn() && isValidId(userId) && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && isUpdateTimestamps(incoming())
          && incoming().uid == existing().uid
          && (request.auth.uid == userId || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // 2. Admin Registry
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isSignedIn() && isValidId(userId)
        && isValidAdminRegistry(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (
            request.auth.uid == userId
            && !exists(/databases/$(database)/documents/institution/config)
            && existsAfter(/databases/$(database)/documents/institution/config)
            && getAfter(/databases/$(database)/documents/institution/config).data.superAdminUid == request.auth.uid
          )
        );
      allow update: if false;
      allow delete: if isSignedIn() && isValidId(userId) && isSuperAdmin();
    }

    // 3. Super Admin Provisioned Role Invites
    match /invites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(inviteId)
        && isValidRoleInvite(incoming())
        && isCreateTimestamps(incoming())
        && incoming().createdByUid == request.auth.uid
        && incoming().ownerId == request.auth.uid
        && isAdmin();
      allow update: if isSignedIn() && isValidId(inviteId)
        && isValidRoleInvite(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().targetUid == existing().targetUid
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'role', 'department', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(inviteId) && isAdmin();
    }

    // 4. Public Contact Us Inquiries (Create-only for public visitors, Admin-only reads)
    match /contactInquiries/{inquiryId} {
      allow get: if isSignedIn() && isValidId(inquiryId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(inquiryId)
        && isValidContactInquiry(incoming())
        && isCreateTimestamps(incoming())
        && incoming().status == 'new';
      allow update: if isSignedIn() && isValidId(inquiryId)
        && isValidContactInquiry(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(inquiryId) && isAdmin();
    }

    // 5. Public Career Applications (Create-only for public applicants, Admin-only reads)
    match /careerApplications/{appId} {
      allow get: if isSignedIn() && isValidId(appId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(appId)
        && isValidCareerApplication(incoming())
        && isCreateTimestamps(incoming())
        && incoming().status == 'submitted';
      allow update: if isSignedIn() && isValidId(appId)
        && isValidCareerApplication(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(appId) && isAdmin();
    }

    // 6. School Classes
    match /classes/{classId} {
      allow get: if isSignedIn() && isValidId(classId)
        && (existing().ownerId == request.auth.uid || existing().assignedTeacherId == request.auth.uid || isBoardViewer(existing()) || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.assignedTeacherId == request.auth.uid || request.auth.uid in resource.data.boardViewerUids || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(classId)
        && isValidSchoolClass(incoming())
        && isCreateTimestamps(incoming())
        && (incoming().ownerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(classId)
        && isValidSchoolClass(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'gradeLevel', 'room', 'scheduleSlot', 'teacherName', 'teacherStaffId', 'assignedTeacherId', 'capacity', 'boardViewerUids', 'updatedAt'])) ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'room', 'scheduleSlot', 'teacherName', 'teacherStaffId', 'assignedTeacherId', 'capacity', 'boardViewerUids', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(classId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 7. Students & Isolated Guardian PII Subcollection
    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId)
        && (existing().ownerId == request.auth.uid || existing().assignedTeacherId == request.auth.uid || existing().linkedUserUid == request.auth.uid || isBoardViewer(existing()) || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.assignedTeacherId == request.auth.uid || resource.data.linkedUserUid == request.auth.uid || request.auth.uid in resource.data.boardViewerUids || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(studentId)
        && isValidStudent(incoming())
        && isCreateTimestamps(incoming())
        && (incoming().ownerId == request.auth.uid || isAdmin())
        && exists(/databases/$(database)/documents/classes/$(incoming().classId));
      allow update: if isSignedIn() && isValidId(studentId)
        && isValidStudent(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && exists(/databases/$(database)/documents/classes/$(incoming().classId))
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'gradeLevel', 'classId', 'className', 'guardianName', 'preferredChannel', 'enrollmentStatus', 'attendanceRate', 'linkedUserUid', 'assignedTeacherId', 'boardViewerUids', 'updatedAt'])) ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'gradeLevel', 'classId', 'className', 'guardianName', 'preferredChannel', 'enrollmentStatus', 'attendanceRate', 'linkedUserUid', 'assignedTeacherId', 'boardViewerUids', 'updatedAt'])) ||
          (existing().assignedTeacherId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['attendanceRate', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(studentId)
        && (existing().ownerId == request.auth.uid || isAdmin());

      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(studentId) && isValidId(docId)
          && (
            get(/databases/$(database)/documents/students/$(studentId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/students/$(studentId)).data.assignedTeacherId == request.auth.uid ||
            isAdmin()
          );
        allow list: if false;
        allow create: if isSignedIn() && isValidId(studentId) && isValidId(docId)
          && isValidStudentGuardianPrivate(incoming())
          && isCreateTimestamps(incoming())
          && (incoming().ownerId == request.auth.uid || isAdmin())
          && existsAfter(/databases/$(database)/documents/students/$(studentId))
          && getAfter(/databases/$(database)/documents/students/$(studentId)).data.ownerId == incoming().ownerId;
        allow update: if isSignedIn() && isValidId(studentId) && isValidId(docId)
          && isValidStudentGuardianPrivate(incoming())
          && isUpdateTimestamps(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().diff(existing()).affectedKeys().hasOnly(['guardianEmail', 'guardianPhone', 'emergencyNotes', 'updatedAt'])
          && (
            get(/databases/$(database)/documents/students/$(studentId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
        allow delete: if isSignedIn() && isValidId(studentId) && isValidId(docId)
          && (
            get(/databases/$(database)/documents/students/$(studentId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    // 8. Attendance Records
    match /attendanceRecords/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId)
        && (existing().ownerId == request.auth.uid || existing().assignedTeacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.assignedTeacherId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(recordId)
        && isValidAttendanceRecord(incoming())
        && isCreateTimestamps(incoming())
        && incoming().recordedByUid == request.auth.uid
        && (incoming().ownerId == request.auth.uid || incoming().assignedTeacherId == request.auth.uid || isAdmin())
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && exists(/databases/$(database)/documents/classes/$(incoming().classId));
      allow update: if isSignedIn() && isValidId(recordId)
        && isValidAttendanceRecord(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().studentId == existing().studentId
        && incoming().classId == existing().classId
        && incoming().date == existing().date
        && (
          (isAdmin() && incoming().recordedByUid == existing().recordedByUid && incoming().diff(existing()).affectedKeys().hasOnly(['assignedTeacherId', 'updatedAt'])) ||
          (isAdmin() && incoming().recordedByUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'notifiedParent', 'recordedByUid', 'period', 'updatedAt'])) ||
          (existing().ownerId == request.auth.uid && incoming().recordedByUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'notifiedParent', 'recordedByUid', 'updatedAt'])) ||
          (existing().assignedTeacherId == request.auth.uid && incoming().recordedByUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'notifiedParent', 'recordedByUid', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(recordId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 9. Parent Notifications
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId)
        && (existing().ownerId == request.auth.uid || existing().assignedTeacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.assignedTeacherId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(notificationId)
        && isValidParentNotification(incoming())
        && isCreateTimestamps(incoming())
        && (incoming().ownerId == request.auth.uid || incoming().assignedTeacherId == request.auth.uid || isAdmin())
        && exists(/databases/$(database)/documents/students/$(incoming().studentId));
      allow update: if isSignedIn() && isValidId(notificationId)
        && isValidParentNotification(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().studentId == existing().studentId
        && (existing().deliveryStatus != 'acknowledged' || isAdmin())
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['assignedTeacherId', 'updatedAt'])) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['deliveryStatus', 'parentReply', 'updatedAt'])) ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['deliveryStatus', 'parentReply', 'updatedAt'])) ||
          (existing().assignedTeacherId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['deliveryStatus', 'parentReply', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(notificationId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 10. Automated Notification Rules
    match /notificationRules/{ruleId} {
      allow get: if isSignedIn() && isValidId(ruleId)
        && (existing().ownerId == request.auth.uid || isTeacherRuleViewer(existing()) || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.teacherViewerUids || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(ruleId)
        && isValidNotificationRule(incoming())
        && isCreateTimestamps(incoming())
        && (incoming().ownerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(ruleId)
        && isValidNotificationRule(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'triggerEvent', 'channel', 'delayMinutes', 'templateText', 'enabled', 'teacherViewerUids', 'updatedAt'])) ||
          (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'triggerEvent', 'channel', 'delayMinutes', 'templateText', 'enabled', 'teacherViewerUids', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isValidId(ruleId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 11. Admissions & Enrolment Workflow (+ Isolated Private Contact)
    match /admissions/{applicationId} {
      allow get: if isSignedIn() && isValidId(applicationId)
        && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(applicationId)
        && isValidAdmissionApplication(incoming())
        && isCreateTimestamps(incoming())
        && incoming().stage != 'enrolled'
        && (incoming().ownerId == request.auth.uid || isAdmin())
        && exists(/databases/$(database)/documents/classes/$(incoming().targetClassId));
      allow update: if isSignedIn() && isValidId(applicationId)
        && isValidAdmissionApplication(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && (!(existing().stage in ['enrolled', 'declined']) || isAdmin())
        && (
          (
            (existing().ownerId == request.auth.uid || isAdmin())
            && incoming().stage == 'enrolled'
            && isValidRefId(incoming().enrolledStudentId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'enrolledStudentId', 'documentsVerified', 'tuitionDepositPaid', 'notes', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/students/$(incoming().enrolledStudentId))
          ) ||
          (
            (existing().ownerId == request.auth.uid || isAdmin())
            && incoming().stage != 'enrolled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['stage', 'documentsVerified', 'tuitionDepositPaid', 'interviewDate', 'notes', 'targetClassId', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(applicationId)
        && (existing().ownerId == request.auth.uid || isAdmin());

      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(applicationId) && isValidId(docId)
          && (
            get(/databases/$(database)/documents/admissions/$(applicationId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
        allow list: if false;
        allow create: if isSignedIn() && isValidId(applicationId) && isValidId(docId)
          && isValidAdmissionPrivateContact(incoming())
          && isCreateTimestamps(incoming())
          && (incoming().ownerId == request.auth.uid || isAdmin())
          && existsAfter(/databases/$(database)/documents/admissions/$(applicationId))
          && getAfter(/databases/$(database)/documents/admissions/$(applicationId)).data.ownerId == incoming().ownerId;
        allow update: if isSignedIn() && isValidId(applicationId) && isValidId(docId)
          && isValidAdmissionPrivateContact(incoming())
          && isUpdateTimestamps(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().diff(existing()).affectedKeys().hasOnly(['guardianEmail', 'guardianPhone', 'updatedAt'])
          && (
            get(/databases/$(database)/documents/admissions/$(applicationId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
        allow delete: if isSignedIn() && isValidId(applicationId) && isValidId(docId)
          && (
            get(/databases/$(database)/documents/admissions/$(applicationId)).data.ownerId == request.auth.uid ||
            isAdmin()
          );
      }
    }

    // 12. School Departments
    match /departments/{departmentId} {
      allow get: if isSignedIn() && isValidId(departmentId)
        && (existing().ownerId == request.auth.uid || isBoardViewer(existing()) || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.boardViewerUids || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(departmentId)
        && isValidDepartment(incoming())
        && isCreateTimestamps(incoming())
        && (incoming().ownerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(departmentId)
        && isValidDepartment(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'code', 'category', 'headName', 'description', 'status', 'boardViewerUids', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(departmentId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 13. Stakeholders, Administration, Teachers & Staff Directory + Performance
    match /staff/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId)
        && (existing().ownerId == request.auth.uid || isBoardViewer(existing()) || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.boardViewerUids || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(staffId)
        && isValidStaffMember(incoming())
        && isCreateTimestamps(incoming())
        && (incoming().ownerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(staffId)
        && isValidStaffMember(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && (
          (
            (existing().ownerId == request.auth.uid || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'roleTitle', 'department', 'staffCategory', 'employmentType', 'status', 'avatarUrl', 'weeklyHoursTarget', 'assignedHours', 'linkedUserUid', 'boardViewerUids', 'updatedAt'])
          ) ||
          (
            (existing().ownerId == request.auth.uid || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['attendanceSubmissionRate', 'parentResponseMinutes', 'observationScore', 'assignedHours', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isValidId(staffId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 14. Automated Staff & Classroom Schedules
    match /schedules/{scheduleId} {
      allow get: if isSignedIn() && isValidId(scheduleId)
        && (existing().ownerId == request.auth.uid || existing().assignedTeacherId == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.assignedTeacherId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(scheduleId)
        && isValidScheduleBlock(incoming())
        && isCreateTimestamps(incoming())
        && (incoming().ownerId == request.auth.uid || isAdmin())
        && exists(/databases/$(database)/documents/staff/$(incoming().staffId))
        && exists(/databases/$(database)/documents/classes/$(incoming().classId));
      allow update: if isSignedIn() && isValidId(scheduleId)
        && isValidScheduleBlock(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && exists(/databases/$(database)/documents/staff/$(incoming().staffId))
        && exists(/databases/$(database)/documents/classes/$(incoming().classId))
        && (
          (existing().ownerId == request.auth.uid || isAdmin())
          && incoming().diff(existing()).affectedKeys().hasOnly(['staffId', 'staffName', 'classId', 'className', 'dayOfWeek', 'periodNumber', 'startTime', 'endTime', 'room', 'subject', 'status', 'assignedTeacherId', 'updatedAt'])
        );
      allow delete: if isSignedIn() && isValidId(scheduleId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // 15. Financial Analytics Ledger (Super Admin read/write, Board read-only via boardViewerUids)
    match /financialRecords/{recordId} {
      allow get: if isSignedIn() && isValidId(recordId)
        && (existing().ownerId == request.auth.uid || isBoardViewer(existing()) || isAdmin());
      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.boardViewerUids || isBootstrappedAdmin());
      allow create: if isSignedIn() && isValidId(recordId)
        && isValidFinancialRecord(incoming())
        && isCreateTimestamps(incoming())
        && (incoming().ownerId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(recordId)
        && isValidFinancialRecord(incoming())
        && isUpdateTimestamps(incoming())
        && incoming().ownerId == existing().ownerId
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().diff(existing()).affectedKeys().hasOnly(['fiscalYear', 'month', 'monthLabel', 'entryType', 'category', 'department', 'amount', 'budgetedAmount', 'status', 'notes', 'boardViewerUids', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(recordId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
