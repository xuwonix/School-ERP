        "teacherViewerUids": { "type": "array", "description": "Bounded list (<= 50) of active Teacher/Staff UIDs allowed read-only access to school automation rules." },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
