        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["applicantName", "email", "roleTitle", "department", "portfolioUrl", "coverNote", "status", "ownerId", "createdAt", "updatedAt"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Homeroom or academic course section.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "code": { "type": "string", "minLength": 2, "maxLength": 24, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "gradeLevel": { "type": "string", "minLength": 1, "maxLength": 30 },
        "room": { "type": "string", "minLength": 1, "maxLength": 40 },
        "scheduleSlot": { "type": "string", "minLength": 1, "maxLength": 60 },
        "teacherName": { "type": "string", "minLength": 1, "maxLength": 100 },
