        "status": { "type": "string", "enum": ["scheduled", "conflict", "substitute_needed"] },
        "assignedTeacherId": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["staffId", "staffName", "classId", "className", "dayOfWeek", "periodNumber", "startTime", "endTime", "room", "subject", "status", "ownerId", "createdAt", "updatedAt"]
    }
  },
