{
  "entities": {
    "InstitutionConfig": {
      "title": "InstitutionConfig",
      "description": "Public non-PII first-time setup status and school identity record.",
      "type": "object",
      "properties": {
        "setupComplete": { "type": "boolean" },
        "superAdminUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "schoolCode": { "type": "string", "minLength": 2, "maxLength": 24, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "schoolAddress": { "type": "string", "minLength": 3, "maxLength": 240 },
        "schoolOwner": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ownerUsername": { "type": "string", "minLength": 3, "maxLength": 48, "pattern": "^[a-zA-Z0-9._\\-]+$" },
        "emailOtpVerified": { "type": "boolean" },
        "phoneOtpVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["setupComplete", "superAdminUid", "schoolName", "schoolCode", "schoolAddress", "schoolOwner", "ownerUsername", "emailOtpVerified", "phoneOtpVerified", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Role-based account metadata without raw PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "username": { "type": "string", "maxLength": 48 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "board", "teacher", "staff", "student"] },
        "schoolName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "department": { "type": "string", "minLength": 1, "maxLength": 80 },
        "avatarUrl": { "type": "string", "maxLength": 300 },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "seeded": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "ownerId", "displayName", "username", "role", "schoolName", "department", "avatarUrl", "accountStatus", "seeded", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII for an authenticated user (email, phone).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "phone", "createdAt", "updatedAt"]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Trusted database record granting admin role to a user UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "RoleInvite": {
      "title": "RoleInvite",
      "description": "Audit log of Super Admin provisioned invite-only user accounts (no plaintext passwords).",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "board", "teacher", "staff", "student"] },
        "department": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetUid", "fullName", "role", "department", "status", "createdByUid", "ownerId", "createdAt", "updatedAt"]
    },
    "ContactInquiry": {
      "title": "ContactInquiry",
      "description": "Public Contact Us inquiry submission readable only by school administrators.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "institutionName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "workEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "topic": { "type": "string", "enum": ["Demo Request", "Admissions Suite", "District Rollout", "Technical Support", "Partnership"] },
        "message": { "type": "string", "minLength": 5, "maxLength": 1500 },
        "status": { "type": "string", "enum": ["new", "reviewed", "archived"] },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "institutionName", "workEmail", "phone", "topic", "message", "status", "ownerId", "createdAt", "updatedAt"]
    },
    "CareerApplication": {
      "title": "CareerApplication",
      "description": "Public Career page application readable only by school administrators.",
      "type": "object",
      "properties": {
        "applicantName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "roleTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "department": { "type": "string", "minLength": 1, "maxLength": 80 },
        "portfolioUrl": { "type": "string", "maxLength": 300 },
        "coverNote": { "type": "string", "minLength": 10, "maxLength": 1500 },
