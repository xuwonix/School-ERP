      "properties": {
        "firstName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "lastName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "studentCode": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "gradeLevel": { "type": "string", "minLength": 1, "maxLength": 30 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "className": { "type": "string", "minLength": 1, "maxLength": 100 },
