      "required": ["name", "code", "gradeLevel", "room", "scheduleSlot", "teacherName", "teacherStaffId", "assignedTeacherId", "capacity", "ownerId", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Enrolled student record without raw guardian email/phone PII.",
