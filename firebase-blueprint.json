        "status": { "type": "string", "enum": ["present", "tardy", "absent", "excused"] },
        "note": { "type": "string", "maxLength": 300 },
        "notifiedParent": { "type": "boolean" },
        "recordedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "assignedTeacherId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "classId", "className", "date", "period", "status", "note", "notifiedParent", "recordedByUid", "ownerId", "assignedTeacherId", "createdAt", "updatedAt"]
